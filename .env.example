# Banco de dados PostgreSQL (Railway fornece DATABASE_URL automaticamente)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/sinutre?schema=public"

# Servidor
PORT=3333
NODE_ENV=development

# JWT — use uma string longa e aleatória em produção
JWT_SECRET="troque-esta-string-por-um-segredo-forte"

# Origens do frontend separadas por vírgula
FRONTEND_URL="http://localhost:5173"

# Fuso horário usado nos agrupamentos diários e nas métricas
APP_TIMEZONE="America/Sao_Paulo"

# GitHub OAuth (opcional — login por e-mail/senha funciona sem ele)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3333/auth/github/callback"
