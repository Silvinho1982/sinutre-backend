// Schema do SiNutre.
// O SQLite não suporta enums no Prisma 5; por isso os campos que no modelo
// original são enums (GENDERCHOICE, MEALCHOICE e LEVELCHOICE) ficam como
// String e são validados na camada de aplicação (src/constants/enums.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  githubId    String?   @unique
  githubLogin String?   @unique
  email       String?   @unique
  passwordHash String?  @map("password_hash")
  name        String
  birthDate   DateTime? @map("birth_date")
  avatarUrl   String?   @map("avatar_url")
  gender      String    @default("NAO_ESPECIFICADO") // GENDERCHOICE
  createdAt   DateTime  @default(now()) @map("created_at")

  meals       Meal[]
  foods       Food[]
  weightLogs  WeightLog[]
  healthData  HealthData[]

  @@map("users")
}

model Meal {
  id          Int       @id @default(autoincrement())
  type        String    // MEALCHOICE
  eatTime     DateTime  @map("eat_time")
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  foods       MealFood[]

  @@index([userId, eatTime])
  @@map("meals")
}

model Food {
  id              Int        @id @default(autoincrement())
  name            String
  caloriesPer100g Float      @map("calories_per_100g")
  carbsPer100g    Float      @map("carbs_per_100g")
  proteinPer100g  Float      @map("protein_per_100g")
  fatPer100g      Float      @map("fat_per_100g")

  userId          Int        @map("user_id")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  meals           MealFood[]

  @@index([userId, name])
  @@map("foods")
}

// Classe associativa Meal <-> Food (n para m)
model MealFood {
  mealId   Int   @map("meal_id")
  foodId   Int   @map("food_id")
  foodG    Float @map("food_g")
  calories Float
  carbs    Float
  protein  Float
  fat      Float

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@id([mealId, foodId])
  @@map("meal_foods")
}

model WeightLog {
  id        Int      @id @default(autoincrement())
  height    Float
  weight    Float
  createdAt DateTime @default(now()) @map("created_at")

  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("weight_logs")
}

model HealthData {
  id               Int       @id @default(autoincrement())
  targetDietDaily  Int       @map("target_diet_daily")
  levelActivity    String    @map("level_activity") // LEVELCHOICE
  createdAt        DateTime  @default(now()) @map("created_at")
  closedAt         DateTime? @map("closed_at")
  isActive         Boolean   @default(true) @map("is_active")

  userId           Int       @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("health_data")
}
